{
  "name": "derivault",
  "version": "0.1.0",
  "description": "Deterministically derive non-custodial privacy keys (RAILGUN shielded + ERC-5564 stealth addresses) from an embedded-wallet signature. Keys are re-derived on demand from the user's login — never stored.",
  "license": "MIT",
  "author": "Blake Duncan",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "tsx scripts/print-vectors.ts",
    "example": "tsx examples/basic.ts",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "ethereum",
    "privacy",
    "stealth-address",
    "erc-5564",
    "railgun",
    "embedded-wallet",
    "hkdf",
    "non-custodial",
    "self-custodial",
    "viem",
    "privy",
    "kohaku"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakecduncan/derivault.git"
  },
  "homepage": "https://github.com/blakecduncan/derivault#readme",
  "bugs": {
    "url": "https://github.com/blakecduncan/derivault/issues"
  },
  "dependencies": {
    "@noble/curves": "^1.4.0",
    "@scure/bip39": "^2.0.1",
    "viem": "^2.38.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@scopelift/stealth-address-sdk": "1.0.0-beta.5",
    "@types/node": "^20",
    "publint": "^0.3.21",
    "tsup": "^8.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
