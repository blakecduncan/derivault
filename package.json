{
  "name": "derivault",
  "version": "0.3.0",
  "description": "Deterministically derive a wallet owner, RAILGUN seed, and ERC-5564 stealth keys from a WebAuthn PRF passkey or EIP-191 signature.",
  "license": "MIT",
  "author": "Blake Duncan",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "vectors": "tsx scripts/print-vectors.ts",
    "example": "tsx examples/basic.ts",
    "check:package": "publint && attw --pack .",
    "prepublishOnly": "pnpm typecheck && pnpm test && pnpm build"
  },
  "keywords": [
    "ethereum",
    "privacy",
    "stealth-address",
    "erc-5564",
    "railgun",
    "embedded-wallet",
    "passkey",
    "webauthn",
    "hkdf",
    "non-custodial",
    "self-custodial",
    "viem",
    "privy",
    "kohaku"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blakecduncan/derivault.git"
  },
  "homepage": "https://github.com/blakecduncan/derivault#readme",
  "bugs": {
    "url": "https://github.com/blakecduncan/derivault/issues"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@scure/bip39": "^2.2.0",
    "viem": "^2.54.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.4",
    "@scopelift/stealth-address-sdk": "1.0.0-beta.5",
    "@types/node": "^20",
    "publint": "^0.3.21",
    "tsup": "^8.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
